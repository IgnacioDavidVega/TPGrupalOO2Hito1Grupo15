<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC 
		"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
		"https://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="datos.UnidadVenta" table="UnidadVenta">
		<id column="idUnidadVenta" name="idUnidadVenta">
			<generator class="identity" />
		</id>
		<property name="nombreComercial" column="nombreComercial" type="string" />
		<one-to-one name="responsableCargo" class="datos.responsableCargo"></one-to-one>
		<property name="superficie" column="superficie" type="long" />
		<property name="codigoUnico" column="codigoUnico" type="string" />
		
		<one-to-many name="datos.Plato" />
		<one-to-many name="datos.Personal" />
		
		<joined-subclass name="datos.FoodTruck" table="foodTruck">
			<key column="idFoodTruck" />
			<property column="patente" name="patente" type="string" />
			<property column="conexionElectrica" name="conexionElectrica" type="boolean" />
		</joined-subclass>

		<joined-subclass name="datos.PuestoDesarmable" table="puestoDesarmable">
			<key column="idPuestoDesarmable" />
			<property column="cantidadCarpas" name="cantidadCarpas" type="long" />
			<property column="tiempoMontaje" name="tiempoMontaje" type="long" />
		</joined-subclass>
	</class>
</hibernate-mapping>